[Unit]
Description=Claude Voice Remote - Telegram bot for Claude Code
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# Set your actual paths here
WorkingDirectory=/path/to/claude-voice-remote
ExecStart=/usr/bin/python3 /path/to/claude-voice-remote/bot.py

# Environment variables - set your token here or in config.py
Environment="TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE"
Environment="AUTHORIZED_USER_IDS=YOUR_USER_ID"
Environment="CLAUDE_CODE_PATH=claude"
Environment="CLAUDE_WORKING_DIR=/path/to/your/workspace"
Environment="WHISPER_MODEL=base"

# Restart on failure
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-voice-remote

[Install]
WantedBy=multi-user.target
